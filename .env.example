# Serenity AI Environment Variables
# Copy this to .env and fill in your actual values
# NEVER commit .env to git! (it's in .gitignore)

# ======================
# REQUIRED API KEYS
# ======================

# --- Google Cloud (for TTS - Chirp3 HD voices) ---
# Get from: https://console.cloud.google.com/
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/google-credentials.json

# --- AI Services (Optimized Stack) ---
# OpenAI Realtime API (Primary Voice AI): Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Groq (LLM - Fallback): Get from https://console.groq.com
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Deepgram (STT - Fallback): Get from https://console.deepgram.com
DEEPGRAM_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Twilio (Phone Service) ---
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_PHONE_NUMBER=+447411XXXXXX  # Your UK phone number

# --- Stripe (Payment Processing for Twilio Pay) ---
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXX  # Use sk_test_ for testing, sk_live_ for production
STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXX  # Optional, only for web dashboard

# ======================
# PRICING & TRIAL CONFIG
# ======================

# --- Twilio Pay Configuration ---
TWILIO_PAY_CONNECTOR_NAME=Serenity AI Stripe  # Name you gave your connector in Twilio console

# --- Pricing (£0.10/min = £6/hour) ---
PRICE_PER_HOUR=6.00  # £6.00 per hour
FREE_TRIAL_MINUTES=5  # 5 minutes free trial for new customers
PAYMENT_PROMPT_AT_MINUTES=4  # Prompt for payment at 4:30 (4.5 minutes)
CURRENCY=GBP

# ======================
# DATABASES
# ======================

# --- Redis (Subscription Tracking) ---
# Local: redis://localhost:6379
# Railway: redis://default:password@redis.railway.internal:6379
REDIS_URL=redis://localhost:6379

# --- PostgreSQL (Conversation Logging & Training Data) ---
# Local: postgresql://user:password@localhost:5432/serenityai
# Railway: postgresql://postgres:password@containers-us-west-123.railway.app:5432/railway
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/serenityai

# ======================
# OPTIONAL SERVICES
# ======================

# --- Google Services (Optional) ---
GEMINI_API_KEY=your_gemini_api_key_here  # Optional fallback LLM
GOOGLE_CSE_ID=your_custom_search_engine_id  # For web search
GOOGLE_MAPS_API_KEY=your_google_maps_key  # For location services

# --- Other APIs (Required for Function Calling) ---
OPENWEATHER_API_KEY=your_openweather_key  # For weather forecasts (get_weather_forecast tool)
NEWS_API_KEY=your_news_api_key  # For UK news headlines (get_uk_news tool) - Get from https://newsapi.org

# ======================
# MCP SERVICES (OPTIONAL)
# ======================

# --- Brave Search API (for Web Search MCP - optional, falls back to DuckDuckGo) ---
# Get from: https://brave.com/search/api/ (2000 requests/month free)
BRAVE_API_KEY=BSA_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ======================
# ENVIRONMENT & SECURITY
# ======================

ENV=development  # development or production
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# PUBLIC BASE URL (REQUIRED for webhook signature validation)
PUBLIC_BASE_URL=https://your-domain.com  # Your public domain (e.g., https://serenityai.railway.app)

# STRIPE WEBHOOK SECRET (REQUIRED for webhook signature validation)
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX  # From Stripe webhook settings

# ======================
# RATE LIMITING & SECURITY
# ======================

RATE_LIMIT_ENABLED=true  # Enable rate limiting to prevent API abuse
MAX_REQUESTS_PER_MINUTE=30  # Max requests per IP per minute
